{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "options": {
    "env": {
      // "RUST_BACKTRACE": "1",
    },
  },
  "presentation": {
    "panel": "dedicated",
    "clear": true,
  },
  "tasks": [
    {
      // Needed for run (F5)
      "type": "shell",
      "label": "cargo build",
      "command": "cargo",
      "args": [
        "build"
      ],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "cargo build release",
      "command": "cargo",
      "args": [
        "build",
        "--release"
      ],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "cargo test fast",
      "command": "cargo",
      "args": [
        "nextest",
        "run",
        "--all-targets",
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "dependsOn": [
        "rustdoc-include"
      ],
    },
    {
      "type": "shell",
      "label": "cargo test all",
      "command": "cargo",
      "args": [
        "test",
        "--doc",
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": [
        "cargo test fast"
      ],
    },
    {
      "type": "shell",
      "label": "cargo watch test",
      "command": "watchexec",
      "args": [
        "-c",
        "--restart",
        "--",
        "cargo",
        "test"
        // "nextest", "run",
        // "nextest", "run", "-p", "{project}", "--test", "{file}", "--", "{module}",
      ],
      "problemMatcher": [],
    },
    {
      "type": "shell",
      "label": "cargo test no-std",
      "command": "cargo",
      "args": [
        "test",
        "--target-dir=target/no-std",
        "--no-default-features",
        "--lib",
        "--tests",
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": [
        "rustdoc-include"
      ],
    },
    {
      "type": "shell",
      "label": "cargo run example",
      "command": "cargo",
      "args": [
        "run",
        "--example",
        "${fileBasenameNoExtension}"
      ],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "watch example",
      "command": "watchexec -c --restart -- cargo run --example ${fileBasenameNoExtension}",
      "args": [],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "cargo doc open",
      "command": "cargo",
      "args": [
        "+nightly",
        "doc",
        "--open",
        "--no-deps",
        "--workspace",
        "--all-features"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "dependsOn": [
        "rustdoc-include"
      ],
    },
    {
      "type": "shell",
      "label": "cargo llvm-cov open",
      "command": "cargo",
      "args": [
        "llvm-cov",
        "--open",
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      },
    },
    {
      "type": "shell",
      "label": "cargo expand test",
      "command": "cargo",
      "args": [
        "expand",
        "-p",
        "parse-display",
        "--test",
        "lib"
      ],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "cargo clippy",
      "command": "cargo",
      "args": [
        "+nightly",
        "clippy",
        "--all-features",
        "--all-targets",
        "--workspace",
        "--",
        "-W",
        "clippy::all"
      ],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "cargo fix & fmt",
      "command": "cargo +nightly fix --all-features --all-targets --allow-dirty --workspace && cargo +nightly clippy --fix --allow-dirty --all-features --all-targets --workspace && cargo fmt",
      "args": [],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "cargo bench",
      "command": "cargo",
      "args": [
        "+nightly",
        "bench",
        "--target-dir",
        "target/bench",
      ],
      "options": {
        "cwd": "${workspaceFolder}/parse-display-benches"
      },
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "cargo update minimal-versions",
      "command": "cargo",
      "args": [
        "+nightly",
        "update",
        "-Z",
        "minimal-versions"
      ],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "update compile error",
      "command": "cargo",
      "args": [
        "test",
        "--test",
        "compile_fail",
        "--",
        "--ignored"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "options": {
        "env": {
          "TRYBUILD": "overwrite",
        }
      }
    },
    {
      "type": "shell",
      "label": "check msrv",
      "command": "cargo hack build --rust-version --workspace --ignore-private",
      "args": [],
      "problemMatcher": [
        "$rustc"
      ],
    },
    {
      "type": "shell",
      "label": "rustdoc-include",
      "command": "rustdoc-include",
      "args": [
        "--root",
        "${workspaceFolder}"
      ],
      "problemMatcher": [
        {
          "owner": "rustdoc-include",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": [
            {
              "regexp": "^(error): (.*)$",
              "severity": 1,
              "message": 2,
            },
            {
              "regexp": "^--> (.*):(\\d+)\\s*$",
              "file": 1,
              "line": 2,
              "loop": true,
            },
          ]
        },
      ],
    },
  ],
}
